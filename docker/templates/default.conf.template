map $http_x_klein_base_url $klein_base_url {
  default "";
  "~^http://10\.(?:[0-9]{1,3}\.){2}[0-9]{1,3}(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$" $http_x_klein_base_url;
  "~^http://192\.168\.(?:[0-9]{1,3})\.(?:[0-9]{1,3})(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$" $http_x_klein_base_url;
  "~^http://193\.168\.1\.177(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$" $http_x_klein_base_url;
  "~^http://172\.(?:1[6-9]|2[0-9]|3[01])\.(?:[0-9]{1,3})\.(?:[0-9]{1,3})(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$" $http_x_klein_base_url;
}

server {
  listen ${APP_PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location ~ ^/klein-relay/(?<klein_action>text2img|img2img|multi-img2img)$ {
    if ($klein_base_url = "") { return 403; }

    set $klein_target "${klein_base_url}/${klein_action}";
    proxy_pass $klein_target;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Klein-Base-Url "";
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    proxy_request_buffering off;
    client_max_body_size 20m;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
